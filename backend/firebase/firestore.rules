rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function counter(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0);
    }
    match /players/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 25;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'kills', 'hordes', 'scrap'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16
        && counter(request.resource.data, 'kills')
        && counter(request.resource.data, 'hordes')
        && counter(request.resource.data, 'scrap');
      allow delete: if false;
      match /devices/{device} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['kills', 'hordes', 'scrap'])
          && request.resource.data.keys().hasOnly(['kills', 'hordes', 'scrap'])
          && counter(request.resource.data, 'kills')
          && counter(request.resource.data, 'hordes')
          && counter(request.resource.data, 'scrap');
        allow delete: if false;
      }
    }
  }
}
